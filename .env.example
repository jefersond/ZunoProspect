# Supabase Configuration
# These values are provided by Lovable Cloud automatically
# For local development, copy this file to .env and fill in the values

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Canonical domain for OAuth redirects (production only)
VITE_PUBLIC_SITE_URL=""

# Zanotelli Bridge (ZunoInboundBridge) -- backend only, manual sandbox test
# client. NEVER prefix with VITE_: the secret must never reach the frontend
# bundle, never be logged, and never be committed with a real value.
# Production must always default to disabled (false) even if this variable
# is missing entirely -- the code treats anything other than the literal
# string "true" as disabled.
ZANOTELLI_BRIDGE_ENABLED=false
ZANOTELLI_BRIDGE_URL=
ZANOTELLI_BRIDGE_SECRET=
ZANOTELLI_BRIDGE_ENVIRONMENT=sandbox
